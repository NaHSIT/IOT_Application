<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Left Fold (Origami shadow connecting top and bottom server blades) -->
    <path android:pathData="M 30 28 L 42 46 L 30 80 L 18 62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30" android:startY="28"
                android:endX="30" android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#1E3A8A"/> <!-- Dark Navy -->
                <item android:offset="1.0" android:color="#0F172A"/> <!-- Deepest Blue -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Server Blade -->
    <path android:pathData="M 30 28 L 78 28 L 90 46 L 42 46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30" android:startY="28"
                android:endX="90" android:endY="46"
                android:type="linear">
                <item android:offset="0.0" android:color="#3B82F6"/> <!-- Blue -->
                <item android:offset="1.0" android:color="#1D4ED8"/> <!-- Darker Blue -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Server Blade -->
    <path android:pathData="M 18 62 L 30 80 L 78 80 L 66 62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="18" android:startY="62"
                android:endX="78" android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#06B6D4"/> <!-- Cyan -->
                <item android:offset="1.0" android:color="#2563EB"/> <!-- Blue -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Server Node / Indicator Lights -->
    <path android:pathData="M 76,35 a 2,2 0 1,0 0,4 a 2,2 0 1,0 0,-4" android:fillColor="#67E8F9" />
    <path android:pathData="M 68,35 a 2,2 0 1,0 0,4 a 2,2 0 1,0 0,-4" android:fillColor="#93C5FD" />

    <!-- Bottom Server Node / Indicator Lights -->
    <path android:pathData="M 64,69 a 2,2 0 1,0 0,4 a 2,2 0 1,0 0,-4" android:fillColor="#A5F3FC" />
    <path android:pathData="M 56,69 a 2,2 0 1,0 0,4 a 2,2 0 1,0 0,-4" android:fillColor="#93C5FD" />

</vector>